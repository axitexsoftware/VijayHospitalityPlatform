APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-characters
SITE_URL=https://www.yourdomain.com
DATABASE_PATH=instance/hotel.db
TAX_PERCENT=0
HOLD_MINUTES=30
CANCEL_FREE_HOURS=24
LATE_CANCEL_REFUND_PERCENT=0
# Razorpay (use test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# AI receptionist: any OpenAI-compatible chat completions API with tool calling
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Browser-native speech APIs; guests can always use text chat instead.
VIRA_VOICE_ENABLED=1
VIRA_TTS_ENABLED=1
VIRA_SPEECH_LANG=en-IN
# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# WhatsApp Cloud API and generic SMS webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Set to 1 when behind a reverse proxy (nginx, Cloudflare)
TRUSTED_PROXY=0
